# Copy this file to ".env" and fill in your own values. Never commit ".env".
DATABASE_URL=postgresql://postgres:password@localhost:5432/metro_trotro
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_STATION_ID=1
# development = warnings only.  production = the server will not start with a weak JWT_SECRET.
APP_ENV=development
